        "value": "未知の工芸品としての箱から、危険な呪物として認識・隔離される"
      },
      "temporal_structure": {
        "status": "known",
        "value": "持ち込み後に危険が顕在化し、回収・隔離へ進む単一エピソード"
      },
      "rules_and_taboos": {
        "status": "known",
        "value": [
