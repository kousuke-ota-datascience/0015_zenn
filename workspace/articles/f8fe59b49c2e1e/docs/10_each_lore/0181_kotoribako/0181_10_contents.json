  "content_units": [
    {
      "content_id": "CNT-001",
      "type": "event",
      "text": "知人が祖父母宅で見つけた精巧な木箱を持ち込み、箱を知る人物が強い危険を認識する。",
      "evidence_refs": [
        "EVD-001",
        "EVD-002"
      ]
    },
    {
      "content_id": "CNT-002",
      "type": "claim",
      "text": "箱は過去の共同体で作られた呪物であり、怨恨を他者へ向けるための器だったと説明される。",
      "evidence_refs": [
        "EVD-002"
      ],
      "notes": "歴史的事実ではなく、物語内部の由来説明。"
    },
    {
      "content_id": "CNT-003",
      "type": "rule",
      "text": "箱の影響はとりわけ女性と子どもに重く作用し、病や死に至らせうるとされる。",
      "evidence_refs": [
        "EVD-002"
      ]
    },
    {
      "content_id": "CNT-004",
      "type": "action",
      "text": "危険を知る人物が箱を隔離・回収し、以後の接触を避けることで被害拡大を防ごうとする。",
      "evidence_refs": [
        "EVD-002"
      ]
    }
  ],
