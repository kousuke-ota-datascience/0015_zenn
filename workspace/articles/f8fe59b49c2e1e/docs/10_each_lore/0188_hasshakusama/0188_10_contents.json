  "content_units": [
    {
      "content_id": "CNT-001",
      "type": "event",
      "text": "親類宅を訪れた語り手が、白い服と帽子を着けた異常に背の高い女性様の存在と、その独特な声を知覚する。",
      "evidence_refs": [
        "EVD-002"
      ]
    },
    {
      "content_id": "CNT-002",
      "type": "claim",
      "text": "親族はその存在を「八尺様」と呼び、一度目を付けられた者を追う危険な地域怪異だと説明する。",
      "evidence_refs": [
        "EVD-002",
        "EVD-003"
      ]
    },
    {
      "content_id": "CNT-003",
      "type": "rule",
      "text": "夜間は封じた部屋から出ず、塩などの防護を保ち、翌朝に複数人で囲んで地域外へ退避する。",
      "evidence_refs": [
        "EVD-003"
      ]
    },
    {
      "content_id": "CNT-004",
      "type": "outcome",
      "text": "語り手は地域外へ逃れるが、後日の地蔵破損が再接近の可能性を示し、完全な解決を留保して終わる。",
      "evidence_refs": [
        "EVD-004"
      ]
    }
