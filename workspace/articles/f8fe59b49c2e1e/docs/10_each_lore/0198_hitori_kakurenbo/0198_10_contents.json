  "content_units": [
    {
      "content_id": "CNT-001",
      "type": "rule",
      "text": "手足のあるぬいぐるみの綿を抜き、米と自分の爪を入れ、赤い糸で縫って準備する。",
      "evidence_refs": [
        "EVD-001"
      ]
    },
    {
      "content_id": "CNT-002",
      "type": "action",
      "text": "深夜にぬいぐるみに名前を付け、浴槽へ置き、鬼役を宣言して刃物を刺した後、暗い家の中へ隠れる。",
      "evidence_refs": [
        "EVD-002"
      ]
    },
    {
      "content_id": "CNT-003",
      "type": "claim",
      "text": "手順を実行すると、家の中に別の存在の気配や物音、映像・音声の異変などが生じうると参加者が語る。",
      "evidence_refs": [
        "EVD-003"
      ]
    },
    {
      "content_id": "CNT-004",
      "type": "rule",
      "text": "終了時は塩水を携えて隠れ場所から出て、ぬいぐるみに塩水を用い、終了宣言をして儀式を閉じる。",
      "evidence_refs": [
        "EVD-002"
      ]
    }
  ],
