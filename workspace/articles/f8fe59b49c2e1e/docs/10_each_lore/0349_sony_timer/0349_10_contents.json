  "content_units": [
    {
      "content_id": "CNT-001",
      "type": "claim",
      "text": "ソニー製品には、保証期間など一定の時期を過ぎた頃に故障するよう仕込まれた『タイマー』がある、という俗説が『ソニータイマー』と呼ばれる。",
      "evidence_refs": [
        "EVD-001"
      ],
      "notes": "俗説の内容であり、意図的設計の事実を示さない。"
    },
    {
      "content_id": "CNT-002",
      "type": "causal_claim",
      "text": "俗説は、製品故障の時期をメーカー側の意図的な設計・寿命設定へ帰属する。",
      "evidence_refs": [
        "EVD-001"
      ]
    },
    {
      "content_id": "CNT-003",
      "type": "counterclaim",
      "text": "2007年の株主総会でソニー側は語の存在を認識しつつ、品質向上策を説明しており、意図的な故障設計を認めてはいない。",
      "evidence_refs": [
        "EVD-002"
      ]
    },
    {
      "content_id": "CNT-004",
      "type": "setting",
      "text": "『ソニータイマー』という語は遅くとも2007年には株主総会で質問されるほど公に流通していた。",
      "evidence_refs": [
        "EVD-003"
      ]
    }
