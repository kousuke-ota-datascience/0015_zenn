{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_common.schema.json",
  "title": "Urban Legend Review Common Definitions",
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "commit_sha", "blob_sha", "reviewed_at"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "severity": {"type": "string", "enum": ["Minor", "Moderate", "Major"]},
    "verdict": {"type": "string", "enum": ["Pass", "Minor", "Moderate", "Major"]},
    "checkStatus": {"type": "string", "enum": ["PASS", "FINDING", "NOT_APPLICABLE"]},
    "reviewCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/checkStatus"},
        "notes": {"type": "string"}
      }
    },
    "auditCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": {"$ref": "#/$defs/checkStatus"},
        "notes": {"type": "string"}
      }
    },
    "dimensionId": {
      "type": "string",
      "enum": ["D01", "D02", "D03", "D04", "D05", "D06", "D07", "D08", "D09", "D10", "D11", "D12", "D13", "D14", "D15", "D16", "D17", "D18", "D19", "D20", "D21"]
    },
    "probeId": {
      "type": "string",
      "enum": ["P01", "P02", "P03", "P04", "P05", "P06", "P07", "P08", "P09", "P10", "P11", "P12"]
    }
  }
}
