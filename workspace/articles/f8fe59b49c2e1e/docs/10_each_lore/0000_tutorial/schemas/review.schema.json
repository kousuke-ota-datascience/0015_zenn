{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "Urban Legend Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entry_id", "artifact", "review_seq", "target", "findings", "verdict"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "entry_id": {"type": "string", "pattern": "^[0-9]{4}$"},
    "artifact": {"type": "string", "enum": ["00", "10", "20"]},
    "review_seq": {"type": "integer", "minimum": 1},
    "target": {"$ref": "#/$defs/target"},
    "checks": {"$ref": "#/$defs/checks"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "verdict": {"type": "string", "enum": ["Pass", "Minor", "Moderate", "Major"]},
    "review_notes": {"type": "string"}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "commit_sha", "blob_sha", "reviewed_at"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "severity", "category", "summary", "rationale", "impact", "fix_direction"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^F[0-9]{3,}$"},
        "severity": {"type": "string", "enum": ["Minor", "Moderate", "Major"]},
        "category": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "fix_direction": {"type": "string", "minLength": 1},
        "content_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CNT-[0-9]{3,}$"}
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"}
        },
        "dimension_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "D01", "D02", "D03", "D04", "D05", "D06", "D07",
              "D08", "D09", "D10", "D11", "D12", "D13", "D14",
              "D15", "D16", "D17", "D18", "D19", "D20", "D21"
            ]
          }
        },
        "probe_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["P01", "P02", "P03", "P04", "P05", "P06", "P07", "P08", "P09", "P10", "P11", "P12"]
          }
        },
        "notes": {"type": "string"}
      }
    },
    "reviewCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "FINDING", "NOT_APPLICABLE"]},
        "summary": {"type": "string"},
        "details": {"type": "array", "items": {"type": "string"}}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary_reconstruction": {"$ref": "#/$defs/reviewCheck"},
        "structural_probe": {"$ref": "#/$defs/reviewCheck"},
        "evidence_content_support": {"$ref": "#/$defs/reviewCheck"},
        "version_scope": {"$ref": "#/$defs/reviewCheck"},
        "content_analysis_support": {"$ref": "#/$defs/reviewCheck"},
        "analysis_invariance": {"$ref": "#/$defs/reviewCheck"}
      }
    }
  }
}
