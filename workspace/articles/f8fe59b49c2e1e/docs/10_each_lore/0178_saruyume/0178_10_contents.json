  "content_units": [
    {
      "content_id": "CNT-001",
      "type": "event",
      "text": "投稿者は夢を見ていると自覚した状態で、薄暗い無人駅に一人でいる。",
      "evidence_refs": [
        "EVD-001"
      ]
    },
    {
      "content_id": "CNT-002",
      "type": "event",
      "text": "遊園地の『お猿さん電車』のような列車が現れ、投稿者は夢の中だから大丈夫だろうと考えて乗車する。",
      "evidence_refs": [
        "EVD-002"
      ]
    },
    {
      "content_id": "CNT-003",
      "type": "event",
      "text": "車内放送が処理内容を告げるたび、他の乗客が順番にその内容どおりの残酷な被害を受ける。",
      "evidence_refs": [
        "EVD-003"
      ]
    },
    {
      "content_id": "CNT-004",
      "type": "event",
      "text": "やがて投稿者自身の処理順が迫り、機械音とともに危害が実行されそうになる。",
      "evidence_refs": [
        "EVD-003",
        "EVD-004"
      ]
    },
    {
      "content_id": "CNT-005",
      "type": "action",
      "text": "投稿者は夢だと認識し、強く目覚めようと念じて、自分への処理直前に覚醒する。",
      "evidence_refs": [
        "EVD-004"
      ]
    },
    {
      "content_id": "CNT-006",
      "type": "event",
      "text": "4年後、以前の夢で逃れた場面の続きから同じ夢が再開する。",
      "evidence_refs": [
        "EVD-005"
      ]
    },
    {
      "content_id": "CNT-007",
      "type": "action",
      "text": "再開した夢でも投稿者は再び覚醒して離脱する。",
      "evidence_refs": [
        "EVD-006"
      ]
    },
    {
      "content_id": "CNT-008",
      "type": "outcome",
      "text": "終端では、次に来た時には逃がさない趣旨の警告が残されるが、三回目の夢や死亡は描かれない。",
      "evidence_refs": [
        "EVD-006"
      ],
      "notes": "後代の『三回目は死亡』等を初期版の確定規則にしない。"
    },
